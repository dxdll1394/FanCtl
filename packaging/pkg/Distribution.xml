<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>FanCtl</title>
    <organization>local.fanctl</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64"/>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Fan control needs AppleSMC write access, which only a root daemon
         has. Refuse to install on anything but Apple Silicon. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="local.fanctl.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="local.fanctl.pkg" visible="false">
        <pkg-ref id="local.fanctl.pkg"/>
    </choice>

    <pkg-ref id="local.fanctl.pkg" version="__VERSION__" onConclusion="none">FanCtl.pkg</pkg-ref>
</installer-gui-script>
